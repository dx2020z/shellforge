# 复制为 .env.local 后填写。不要提交 .env.local。
# 线上部署时，在 Vercel 后台的 Environment Variables 里填同名变量。

# DeepSeek：造物生成、嘲讽、墓志铭
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Tripo：部件 3D 生成
TRIPO_API_KEY=
TRIPO_MODEL=
TRIPO_BASE_URL=
# 额外允许的模型下载主机名，逗号分隔（默认只允许 tripo3d.ai / tripo3d.com）
TRIPO_ASSET_HOSTS=

# Vercel Blob：线上保存生成任务与模型（本地开发不填则写入 .runtime/）
BLOB_READ_WRITE_TOKEN=

# Upstash Redis：线上生成任务记录与限流。在 Vercel 市场一键连接 Upstash 时会自动生成 KV_REST_API_URL / KV_REST_API_TOKEN，代码两种名字都认，不用手动改名
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 全站每日生成上限（造物生成次数），默认 400
SHELLFORGE_DAILY_FORGE_LIMIT=

# 全站每日 Tripo 专属部件上限（每只造物 3 件），默认 300。超过后造物只用预生成部件，不再扣 Tripo 额度
SHELLFORGE_DAILY_MODEL_LIMIT=
