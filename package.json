{
  "name": "shellforge",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start -p 3020",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run check:assets",
    "check:assets": "tsx scripts/check-assets.ts",
    "check:deepseek": "node scripts/check-deepseek.mjs",
    "fonts": "python3 scripts/subset-fonts.py",
    "screens": "tsx scripts/screens.ts",
    "sim": "tsx scripts/sim.ts",
    "audit": "tsx scripts/audit-layout.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.0",
    "motion": "13.4.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
