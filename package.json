{
  "name": "shellforge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3018",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3018",
    "test": "node scripts/test.mjs && vitest run --pool=threads --maxWorkers=1 && npm run check:assets",
    "check:assets": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/check-assets.ts",
    "check:deepseek": "node scripts/check-deepseek.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "pack:teammates": "node scripts/pack-teammates.mjs",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "jsdom": "^29.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
